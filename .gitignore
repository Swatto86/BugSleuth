/target
**/*.rs.bk

# Frontend build output and dependencies. `node_modules/` unanchored so a
# nested one (ui/node_modules) is ignored too — a stray vitest cache under it
# was committed once because only the root was listed.
node_modules/
/ui/dist
tsconfig.tsbuildinfo

# Tauri's generated schemas and per-build artifacts.
/src-tauri/gen

# Sweep output. These contain findings against real repositories and are
# regenerated by `bugsleuth`; they are not source.
/runs/
/runs-demo/

# Throwaway worktrees an isolated sweep (Kilo) creates so it cannot alter the
# code it is reviewing.
/.bugsleuth-worktrees/

# Downloaded WebDriver binary, version-matched to the installed WebView2
# runtime. A ~40 MB tool, not source. scripts/setup-e2e.ps1 fetches it.
/.webdriver

# A stray clone landed here once, from a `git clone` with no target directory,
# and was committed as a gitlink to a public repository. It is a sibling repo,
# never a part of this one.
windows-rdp-keepalive/

# The updater public key. It lives in src-tauri/tauri.conf.json, which is what
# the app actually compiles in; a second copy here would be a value with two
# homes and no check that they agree.
bugsleuth-updater.key*

# Claude Code accumulates per-session permission grants here, including
# scratch paths from whatever was being debugged. Not project configuration.
.claude/settings.json
.claude/settings.local.json
