{
  "name": "bugsleuth-ui",
  "private": true,
  "version": "0.2.16",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test --test-reporter=spec ui/src/*.test.ts",
    "e2e": "npm run e2e:build && wdio run e2e/wdio.conf.ts",
    "e2e:build": "npx --yes @tauri-apps/cli@^2 build --no-bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2"
  },
  "devDependencies": {
    "@wdio/cli": "^9.30.0",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "prettier": "3.6.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
