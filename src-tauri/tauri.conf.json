{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BugSleuth",
  "version": "0.2.12",
  "identifier": "co.swatto.bugsleuth",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BugSleuth",
        "width": 1100,
        "height": 760,
        "minWidth": 780,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0b1220"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "shortDescription": "Adversarial cross-vendor code review",
    "longDescription": "Runs several AI coding CLIs over a repository with different review mandates, merges what they find, and proves the top defects with failing tests.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyOEMxRDc4OUJFMDhCOTkKUldTWmkrQ2JlQjJNUW4wV0tpcGFjbEFvQndhWWVYQkVnZk5mY1l0UVFuWEk0ZEw3RDF0QStqKy8K",
      "endpoints": [
        "https://github.com/Swatto86/BugSleuth/releases/latest/download/latest.json"
      ]
    }
  }
}
